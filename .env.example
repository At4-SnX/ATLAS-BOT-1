# Copie ce fichier en ".env" en local, ou configure ces variables
# directement dans l'onglet "Variables" de ton service Railway.
# NE JAMAIS commit le fichier .env réel sur GitHub.

# ─── Discord ───────────────────────────────────────────────
DISCORD_TOKEN=ton_token_discord_ici

# ─── Arrivées / Départs ─────────────────────────────────────
# ID du salon texte où les images d'arrivée sont envoyées
WELCOME_CHANNEL_ID=id_du_salon_arrivees

# ID du salon texte où les images de départ sont envoyées
# (laisser vide pour utiliser le même salon que WELCOME_CHANNEL_ID)
LEAVE_CHANNEL_ID=id_du_salon_departs

# ─── Salon vocal d'attente STAFF ─────────────────────────────
# ID du salon vocal dans lequel le bot reste connecté en permanence, et où
# il annonce le message d'accueil vocal quand quelqu'un le rejoint.
VOICE_CHANNEL_ID=id_du_salon_vocal

# Délai (en millisecondes) entre la détection de l'arrivée dans le salon
# vocal et le début de l'annonce, pour laisser le temps au client Discord
# du nouvel arrivant de finir sa connexion audio (évite que le début de la
# phrase soit coupé). Augmente si le début est encore coupé chez toi.
VOICE_ANNOUNCE_DELAY_MS=1800
